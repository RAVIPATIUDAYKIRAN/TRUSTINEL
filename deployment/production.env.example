# TRUSTINEL Production Environment Template
# COPY THIS FILE TO .env AND POPULATE SECURE VALUES BEFORE DEPLOYMENT
# DO NOT COMMIT THE ACTUAL .env FILE TO VERSION CONTROL

APP_NAME=TRUSTINEL
APP_VERSION=0.1.0
ENVIRONMENT=production
LOG_LEVEL=INFO
LOG_FORMAT=json

# Database Credentials & Connection
POSTGRES_USER=trustinel_admin
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_SECURE_RANDOM_PASSWORD_32_CHARS
POSTGRES_DB=trustinel_prod
DATABASE_URL=postgresql+asyncpg://trustinel_admin:CHANGE_THIS_TO_A_SECURE_RANDOM_PASSWORD_32_CHARS@db:5432/trustinel_prod
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30

# Redis Security & Connection
REDIS_URL=redis://redis:6379/0

# Production CORS Security (Set to your exact domain / extension origin)
CORS_ORIGINS=["https://api.trustinel.org"]
ENABLE_DOCS=false

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_POST_SCAN=10
RATE_LIMIT_GET_SCAN=60
RATE_LIMIT_AI_STATUS=30

# Threat Intelligence & AI APIs (Optional)
AI_EXPLANATION_ENABLED=false
AI_THREAT_ANALYSIS_ENABLED=false
