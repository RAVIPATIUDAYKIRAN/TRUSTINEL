# TRUSTINEL Production Environment Configuration Template
# Copy to deployment/.env or specify when running containers

# Application Release Configuration
APP_NAME=TRUSTINEL
APP_VERSION=0.1.0
ENVIRONMENT=production
LOG_LEVEL=INFO
LOG_FORMAT=json

# Database Connection Pool Settings
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_THIS_PRODUCTION_PASSWORD@db:5432/trustinel
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30.0

# Redis Cache Connection
REDIS_URL=redis://redis:6379/0

# CORS & API Security Configuration
CORS_ORIGINS=["https://trustinel.example.com"]
CORS_ORIGIN_REGEX=^chrome-extension://.*$
ENABLE_DOCS=false

# API Rate Limiting Configuration
RATE_LIMIT_ENABLED=true
RATE_LIMIT_POST_SCAN=10
RATE_LIMIT_GET_SCAN=60
RATE_LIMIT_AI_STATUS=30
RATE_LIMIT_WINDOW_SECONDS=60

# AI Risk Explanation Service Settings
AI_EXPLANATION_ENABLED=false
AI_EXPLANATION_PROVIDER=openai
AI_EXPLANATION_MODEL=gpt-4o-mini
# AI_EXPLANATION_API_KEY=sk-proj-YOUR-OPENAI-KEY-HERE

# AI Threat Analysis Service Settings
AI_THREAT_ANALYSIS_ENABLED=false
AI_THREAT_ANALYSIS_PROVIDER=openai
AI_THREAT_ANALYSIS_MODEL=gpt-4o-mini
# AI_THREAT_ANALYSIS_API_KEY=sk-proj-YOUR-OPENAI-KEY-HERE
AI_THREAT_ANALYSIS_TIMEOUT_SECONDS=10.0
AI_THREAT_ANALYSIS_CACHE_TTL_SECONDS=600
