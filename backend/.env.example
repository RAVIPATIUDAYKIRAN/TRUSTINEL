# General App Configuration
APP_NAME=TRUSTINEL
APP_VERSION=0.1.0
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=text
ENABLE_DOCS=true

# Security & CORS Configuration
CORS_ORIGINS=["http://127.0.0.1:8000","http://localhost:8000","http://localhost:3000"]
CORS_ORIGIN_REGEX=^chrome-extension://.*$

# Rate Limiting Configuration
RATE_LIMIT_ENABLED=true
RATE_LIMIT_POST_SCAN=10
RATE_LIMIT_GET_SCAN=60
RATE_LIMIT_AI_STATUS=30
RATE_LIMIT_WINDOW_SECONDS=60

# Database Connection (PostgreSQL async pg driver)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/trustinel
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30.0

# Cache / Task Queue (Redis connection URL)
REDIS_URL=redis://redis:6379/0

# AI Risk Explanation Configuration
AI_EXPLANATION_ENABLED=false
AI_EXPLANATION_PROVIDER=openai
AI_EXPLANATION_MODEL=gpt-4o-mini
AI_EXPLANATION_API_KEY=<your-api-key>

# AI Threat Analysis Configuration
AI_THREAT_ANALYSIS_ENABLED=false
AI_THREAT_ANALYSIS_PROVIDER=openai
AI_THREAT_ANALYSIS_MODEL=gpt-4o-mini
AI_THREAT_ANALYSIS_API_KEY=<your-api-key>
AI_THREAT_ANALYSIS_TIMEOUT_SECONDS=10.0
AI_THREAT_ANALYSIS_CACHE_TTL_SECONDS=600
